{
  "name": "@avdmgr/api",
  "version": "1.1.0",
  "private": true,
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && func start",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@avdmgr/shared": "*",
    "@azure/arm-alertsmanagement": "^1.0.0-beta.1",
    "@azure/arm-compute": "^25.0.0",
    "@azure/arm-costmanagement": "^1.0.0",
    "@azure/arm-desktopvirtualization": "^1.2.0",
    "@azure/arm-network": "^37.0.0",
    "@azure/arm-storage": "^20.1.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-query-logs": "^1.0.0",
    "@azure/storage-file-share": "^12.32.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
